# Default for everything: normalize to LF in the repository, and let git detect
# binary content by inspection rather than by extension. This checkout runs with
# core.autocrlf=true, so without a default any newly added text file gets
# committed with CRLF -- which is how *.css, *.txt, *.mjs, *.toml and .coveragerc
# each slipped through in turn. The explicit rules below stay as documentation of
# intent; the vendor override at the end is the one that genuinely matters.
* text=auto eol=lf

*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
Dockerfile text eol=lf
requirements*.txt text eol=lf

# Third-party files copied verbatim by scripts/vendor-assets.mjs. No line-ending
# conversion: the fonts are binary, and the rest must stay byte-for-byte
# identical to the packages pinned in package-lock.json.
app/static/vendor/** -text
*.woff binary
*.woff2 binary
